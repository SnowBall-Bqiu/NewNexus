NEWNEXUS_ENV=production
NEWNEXUS_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Optional: a separate random one-time initialization code, 32–512 characters without whitespace.
# If omitted, read /var/lib/newnexus/bootstrap.token locally after first start.
# NEWNEXUS_SETUP_TOKEN=
NEWNEXUS_DATA_DIR=/var/lib/newnexus
NEWNEXUS_WEB_DIR=/opt/newnexus/web
NEWNEXUS_HTTP_ADDR=127.0.0.1:8080
# Unset, empty or whitespace-only trusts 127.0.0.1/32, ::1/128 and these Docker pools:
# 172.17.0.0/16, 172.18.0.0/16, 172.19.0.0/16,
# 172.20.0.0/14, 172.24.0.0/14, 172.28.0.0/14 (172.17.0.0 through 172.31.255.255).
# Every source in those ranges is trusted; keep backend access limited to proxies.
# Other Docker subnets (192.168.0.0/16, 10.0.0.0/8 or IPv6) need explicit configuration.
# Set none (case-insensitive; surrounding whitespace ignored) to ignore X-Forwarded-For.
# A non-empty comma-separated proxy IP/CIDR list completely replaces those defaults.
# Use proxy source addresses as actually seen by the backend.
# NEWNEXUS_TRUSTED_PROXIES=
NEWNEXUS_GRPC_ADDR=0.0.0.0:9090
# Public TLS gRPC host:port reached by remote probe nodes, not the bind address.
# Required for installation command defaults when listening on a wildcard address.
# NEWNEXUS_AGENT_PUBLIC_ADDR=agents.example.com:443
# Optional HTTP(S) origin reachable by remote nodes; separate from the gRPC address.
# Use an origin only, without credentials, path, query or fragment.
# NEWNEXUS_AGENT_DOWNLOAD_ORIGIN=https://console.example.com
# Optional default console link shown to administrators; separate from API/downloads and gRPC.
# NEWNEXUS_CONSOLE_ORIGIN=https://console.example.com
# The console's addresses.* settings override these public defaults in the database.
# Saving an empty address setting restores its environment/runtime default.
# Optional: defaults to NEWNEXUS_WEB_DIR/agent; must contain both Linux Agent binaries.
# NEWNEXUS_AGENT_DOWNLOAD_DIR=/opt/newnexus/web/agent
NEWNEXUS_TLS_CERT=/etc/newnexus/tls/fullchain.pem
NEWNEXUS_TLS_KEY=/etc/newnexus/tls/privkey.pem
# Leave unset for SQLite; MySQL 8.4 is the production server database.
# URL-encode the password. tls=true verifies the server certificate and hostname.
# NEWNEXUS_DATABASE_URL=mysql://newnexus:URL_ENCODED_PASSWORD@db.example.com:3306/newnexus?tls=true
# Private CA (absolute path; optionally tls_server_name=db.example.com):
# NEWNEXUS_DATABASE_URL=mysql://newnexus:URL_ENCODED_PASSWORD@db.example.com:3306/newnexus?tls=true&tls_ca=/etc/newnexus/db-ca.pem
# tls=false is limited to a controlled, isolated local network such as the supplied Compose profile.
