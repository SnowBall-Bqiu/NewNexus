newnexus.example.com {
	encode zstd gzip
	reverse_proxy /api/* control-plane:8080
	reverse_proxy /healthz control-plane:8080
	reverse_proxy /readyz control-plane:8080
	reverse_proxy control-plane:8080
}

# Agent gRPC 默认由控制端直接加载证书并监听公网 TLS 端口。
# 只有非容器部署明确绑定 127.0.0.1、清空证书变量并开启 NEWNEXUS_GRPC_ALLOW_H2C 时，
# 才可另行启用以下同机反向代理：
# grpc.newnexus.example.com {
# 	reverse_proxy h2c://127.0.0.1:9090
# }
