{
  "name": "newnexus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:motion && npm run check:i18n && npm run check:theme && npm run check:kumo && tsc -b && vite build",
    "check:motion": "node scripts/check-motion.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:kumo": "node scripts/check-kumo.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.9.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.59.20",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "react-virtuoso": "^4.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^30.0.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
