FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/newnexus-agent ./cmd/agent

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata && addgroup -S newnexus && adduser -S -G newnexus newnexus
WORKDIR /var/lib/newnexus-agent
COPY --from=builder /out/newnexus-agent /usr/local/bin/newnexus-agent
RUN chown -R newnexus:newnexus /var/lib/newnexus-agent
USER newnexus
ENTRYPOINT ["newnexus-agent"]
