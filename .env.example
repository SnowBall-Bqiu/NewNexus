# 主密钥，用于加密敏感数据。生成命令: openssl rand -base64 32
NEWNEXUS_MASTER_KEY=

# 应用的公共访问地址，用于生成外部链接和回调 URL
NEWNEXUS_PUBLIC_URL=http://localhost:8080

# Agent 服务的公共访问地址（主机名:端口），供外部 Agent 连接使用
NEWNEXUS_AGENT_PUBLIC_SERVER=localhost:9090

# HTTP 服务监听端口（Web 控制台和 API）
NEWNEXUS_HTTP_PORT=8080

# gRPC 服务监听端口（Agent 通信）
NEWNEXUS_GRPC_PORT=9090

# 是否启用安全 Cookie（HTTPS 环境下应设为 true）
NEWNEXUS_SECURE_COOKIES=true

# --- PostgreSQL 配置（仅 PostgreSQL 模式使用） ---

# PostgreSQL 数据库密码
POSTGRES_PASSWORD=

# --- 本地 Agent 配置（可选，用于容器化部署时自动注册本地探测节点） ---

# Agent 注册码，需先在「探测节点」页面创建
NEWNEXUS_AGENT_ENROLL_CODE=

# Agent 连接的控制面地址（容器内部通信地址）
NEWNEXUS_AGENT_SERVER=control-plane-sqlite:9090

# 本地 Agent 的显示名称
NEWNEXUS_AGENT_NAME=local-docker-agent
