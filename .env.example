# Generate a separate 32-byte base64 key, keep it outside Git, and back it up.
# Example: openssl rand -base64 32
NEWNEXUS_MASTER_KEY=
# Optional one-time setup proof (32–512 random characters, without whitespace). When empty,
# production creates a private /data/bootstrap.token file; read it locally.
NEWNEXUS_SETUP_TOKEN=
NEWNEXUS_IMAGE=newnexus:local
NEWNEXUS_AGENT_IMAGE=newnexus-agent:local
NEWNEXUS_HTTPS_PORT=8443
NEWNEXUS_GRPC_PORT=9443
NEWNEXUS_TLS_DIR=./deploy/tls
# Compose app password: generate a random hexadecimal string (e.g. openssl rand -hex 32).
# The same value is used in the URL, so this Compose example requires hexadecimal characters.
# Compose resolves all profiles; set this value even when starting only SQLite.
MYSQL_PASSWORD=
# InnoDB data/index cache; MySQL also needs memory for connections and queries.
MYSQL_BUFFER_POOL_SIZE=512M
# Public DNS SAN of the TLS certificate; used when the optional local Agent dials the Compose network alias.
NEWNEXUS_TLS_SERVER_NAME=newnexus.example.com
NEWNEXUS_AGENT_ENROLLMENT_TOKEN=
NEWNEXUS_AGENT_ALLOWED_PORTS=80,443
