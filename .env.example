# 使用 openssl rand -base64 32 生成并永久备份该值
NEWNEXUS_MASTER_KEY=replace-with-openssl-rand-base64-32
# PostgreSQL profile 使用的数据库强密码
POSTGRES_PASSWORD=replace-with-a-long-random-password
# 控制台对浏览器公开的 HTTPS 地址
NEWNEXUS_PUBLIC_URL=https://newnexus.example.com
# Agent 访问的 TLS gRPC 地址
NEWNEXUS_AGENT_PUBLIC_SERVER=grpc.newnexus.example.com:9090
# 宿主机发布的内置 TLS gRPC 端口
NEWNEXUS_GRPC_PORT=9090
# 挂载目录内必须包含 grpc.crt 和 grpc.key，证书名称应匹配上方 Agent 地址
NEWNEXUS_GRPC_TLS_DIR=./deploy/tls
# 默认直接发布内置 TLS gRPC；可按防火墙或主机网卡收窄绑定地址
NEWNEXUS_GRPC_BIND_IP=0.0.0.0
# 生产默认禁止 h2c
NEWNEXUS_GRPC_ALLOW_H2C=false
# 全站启用 HTTPS 后将以下两项设为 true
NEWNEXUS_SECURE_COOKIES=true
NEWNEXUS_ENABLE_HSTS=true
# 按实际 Docker 或反向代理网络填写，例如 172.16.0.0/12
NEWNEXUS_TRUSTED_PROXY_CIDRS=
# 可选本机 Agent profile 的一次性注册码
NEWNEXUS_AGENT_ENROLL_CODE=replace-after-creating-node-in-console
# 可选固定 gRPC 叶证书 SHA-256；控制台生成的远程安装命令会自动带上实际指纹
NEWNEXUS_AGENT_TLS_SHA256=
# 节点凭据过期后，在控制台生成一次性恢复码并写入此处
NEWNEXUS_AGENT_RECOVERY_CODE=
# 内置 TLS 模式必须为 false
NEWNEXUS_AGENT_INSECURE=false
# 厂商 API 退避与单适配器限流
NEWNEXUS_PROVIDER_MAX_RETRIES=3
NEWNEXUS_PROVIDER_MIN_INTERVAL=100ms
