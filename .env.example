# Generate with: openssl rand -base64 32
NEWNEXUS_MASTER_KEY=
NEWNEXUS_PUBLIC_URL=http://localhost:8080
NEWNEXUS_AGENT_PUBLIC_SERVER=localhost:9090
NEWNEXUS_HTTP_PORT=8080
NEWNEXUS_GRPC_PORT=9090
NEWNEXUS_SECURE_COOKIES=false

# PostgreSQL profile only
POSTGRES_PASSWORD=

# Optional local Agent profile. Create this code in 探测节点 first.
NEWNEXUS_AGENT_ENROLL_CODE=
NEWNEXUS_AGENT_SERVER=control-plane-sqlite:9090
NEWNEXUS_AGENT_NAME=local-docker-agent
